# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

target 'FoodAiOrderingExample' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  # `use_native_modules!` above autolinks `FoodaiOrderingReactNative` from `../..`
  # as a `:path` development pod. Run `scripts/fetch-ios-sdk.sh` in `pre_install`
  # so the matching `v0.7.1` XCFramework is always fetched (and any stale cached
  # version replaced) before CocoaPods integrates targets.
  pre_install do |_installer|
    fetch_script = File.expand_path('../../scripts/fetch-ios-sdk.sh', __dir__)
    unless system('sh', fetch_script)
      raise 'Failed to fetch foodai_orderingagent.xcframework via scripts/fetch-ios-sdk.sh'
    end
  end

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )

    # Xcode 26+ (newer Apple Clang) rejects {fmt}'s consteval format strings
    # under C++20. Build just the fmt pod as C++17 to disable consteval.
    installer.pods_project.targets.each do |target|
      if target.name == 'fmt'
        target.build_configurations.each do |build_config|
          build_config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
        end
      end
    end
  end
end
