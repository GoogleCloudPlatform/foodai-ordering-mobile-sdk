{
  "name": "@google-cloud/foodai-ordering-react-native",
  "version": "0.7.1",
  "description": "React Native mobile SDK for Google Cloud Food Ordering AI Agent (headless bidirectional streaming and native voice ordering).",
  "license": "Apache-2.0",
  "author": "Google LLC",
  "homepage": "https://github.com/GoogleCloudPlatform/foodai-ordering-mobile-sdk/tree/main/react-native",
  "repository": {
    "type": "git",
    "url": "https://github.com/GoogleCloudPlatform/foodai-ordering-mobile-sdk.git",
    "directory": "react-native"
  },
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/src/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "bin": {
    "foodai-fetch-ios-sdk": "./scripts/fetch-ios-sdk.sh"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "scripts",
    "react-native.config.js",
    "FoodaiOrderingReactNative.podspec",
    "LICENSE",
    "README.md",
    "!ios/Frameworks",
    "!ios/Frameworks/**",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:example": "tsc --noEmit -p example/tsconfig.json",
    "test": "jest",
    "build": "bob build",
    "clean": "del-cli android/build lib",
    "prepack": "bob build"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-native": ">=0.76.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/jest": "^29.5.9",
    "@types/react": "^19.2.0",
    "del-cli": "^5.1.0",
    "jest": "^29.7.0",
    "react": "19.2.0",
    "react-native": "0.83.0",
    "react-native-builder-bob": "^0.30.2",
    "ts-jest": "^29.4.0",
    "typescript": "^5.3.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ]
  },
  "overrides": {
    "regexpu-core": "6.2.0",
    "regenerate": "1.4.2"
  },
  "codegenConfig": {
    "name": "FoodOrderingSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.google.cloud.foodai.ordering.reactnative"
    },
    "ios": {
      "modulesProvider": {
        "FoodOrderingModule": "FoodOrderingModule"
      }
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "keywords": [
    "google-cloud",
    "foodai",
    "food-ordering",
    "conversational-ai",
    "voice-ordering",
    "react-native",
    "ios",
    "android"
  ]
}
